# ============================================================
# CONFIGURAÇÕES DO SISTEMA PREDITIVO — VIDAL TRANSPORTES
# Renomeie este arquivo para .env antes de rodar
# NUNCA suba o .env real para o GitHub
# ============================================================

# Chave da API de clima (gratuita em https://openweathermap.org/api)
OPENWEATHER_API_KEY=sua_chave_aqui

# Banco de dados principal do projeto (onde ficam lineup + clima + telemetria)
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DB_URL=postgresql://vidal_user:senha_segura@localhost:5432/vidal_portos

# Banco de telemetria interno da Vidal (somente leitura)
# Ajustar host, porta e schema conforme infraestrutura da empresa
DB_FROTA_URL=postgresql://readonly_user:senha@servidor_interno:5432/telemetria
